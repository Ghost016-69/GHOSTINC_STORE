# Copy to .env.local and fill in from your Supabase project settings
# (Project Settings -> API). Both values are baked into the built bundle at
# build time, so treat them as public — which is fine, because Row Level
# Security is what protects the data. Never put the service_role key here.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key

# Optional. Must match the GitHub repository name, because GitHub Pages serves
# the site from a subpath. vite.config.ts defaults to /GHOSTINC_STORE/ in
# production, so you only need this if the repo is named something else.
# GITHUB_PAGES_BASE=/GHOSTINC_STORE/
